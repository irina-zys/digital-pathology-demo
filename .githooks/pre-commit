#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"
project_root=$(pwd)
if ! command -v uv >/dev/null 2>&1; then
    echo "Ruff hook requires uv on PATH. Install uv and run uv sync --locked." >&2
    exit 1
fi

snapshot=$(mktemp -d "${TMPDIR:-/tmp}/digital-pathology-lint.XXXXXX")
trap 'rm -rf "$snapshot"' 0
trap 'exit 1' 1 2 15

# Check the staged tree so an unstaged fix cannot hide a committed lint error.
git checkout-index --all --ignore-skip-worktree-bits --prefix="$snapshot/"
cd "$snapshot"
uv run --locked --project "$project_root" ruff check --no-cache --no-fix --no-fix-only --config pyproject.toml .
